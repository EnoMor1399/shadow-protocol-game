NODE_ENV=production

# Host-side secrets. Never commit real values.
ORCHESTRATOR_ATTESTATION_SECRET=
SERVER_REGISTRATION_SECRET=

# Dedicated-server executable and launch identity.
GAME_SERVER_EXECUTABLE=/opt/shadow-protocol/ShadowProtocolServer
GAME_SERVER_MAP=/Game/Maps/Embassy/Embassy_P
SP_BACKEND_URL=https://shadow-protocol-game.onrender.com
SP_SERVER_ID=
SP_REGION=acc
SP_PUBLIC_HOST=
SP_PUBLIC_PORT=7777
SP_CAPACITY=10
SP_NETWORK_BUILD=SP-1.0.1

# Optional JSON array of additional non-secret Unreal command-line arguments.
SP_SERVER_EXTRA_ARGS_JSON=[]
SERVER_ATTESTATION_TTL_MS=60000
