# Shadow Protocol trusted identity gateway
PORT=8090
HOST=0.0.0.0
NODE_ENV=production

# Must match the gameplay backend verifier secret.
PLATFORM_IDENTITY_ASSERTION_SECRET=
PLATFORM_IDENTITY_ASSERTION_TTL_MS=60000
ACCEPTED_NETWORK_BUILDS=SP-1.0.1

# Per-process abuse controls. Also enforce distributed/edge rate limiting in production.
PROVIDER_IP_MAX_ATTEMPTS=30
PROVIDER_CREDENTIAL_MAX_ATTEMPTS=5
PROVIDER_RATE_WINDOW_MS=60000

# Steam server-side AuthenticateUserTicket configuration.
STEAM_WEB_API_KEY=
STEAM_APP_ID=
STEAM_WEB_API_IDENTITY=shadow-protocol

# EOS: HTTPS sidecar/service that invokes EOS_Auth_VerifyIdToken or EOS_Connect_VerifyIdToken.
EOS_VERIFIER_URL=
EOS_VERIFIER_SHARED_SECRET=
EOS_EXPECTED_PRODUCT_ID=
EOS_EXPECTED_SANDBOX_ID=
EOS_EXPECTED_DEPLOYMENT_ID=

LOG_LEVEL=info
