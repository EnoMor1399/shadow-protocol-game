NODE_ENV=production

# Secrets - replace on the host and keep this file mode 600.
ORCHESTRATOR_ATTESTATION_SECRET=
SERVER_REGISTRATION_SECRET=

# Live Shadow Protocol control plane.
SP_BACKEND_URL=https://shadow-protocol-game.onrender.com

# Unique node identity.
SP_SERVER_ID=ACC-PROTOCOL-01
SP_REGION=acc
SP_PUBLIC_HOST=REPLACE_WITH_PUBLIC_IPV4_OR_DNS
SP_PUBLIC_PORT=7777
SP_CAPACITY=10
SP_NETWORK_BUILD=SP-1.0.1

# Packaged Linux server executable. Update this path to the executable
# found in /opt/shadow-protocol/server after packaging.
GAME_SERVER_EXECUTABLE=/opt/shadow-protocol/server/ShadowProtocolServer
GAME_SERVER_MAP=/Game/Maps/Embassy/Embassy_P

SERVER_ATTESTATION_TTL_MS=60000
SP_SERVER_EXTRA_ARGS_JSON=["-unattended","-NoCrashDialog"]
