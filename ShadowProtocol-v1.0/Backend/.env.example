PORT=8080
DATABASE_URL=postgres://shadow:shadow@localhost:5432/shadow_protocol
REDIS_URL=redis://localhost:6379
SESSION_SIGNING_SECRET=replace-with-strong-random-secret
# Migration-only trusted gateway endpoint. Production defaults this route off.
ENABLE_LEGACY_SESSION_BOOTSTRAP=false
SESSION_BOOTSTRAP_SECRET=replace-with-migration-only-identity-gateway-secret
PLATFORM_IDENTITY_ASSERTION_SECRET=replace-with-identity-gateway-assertion-verifier-secret
PLATFORM_IDENTITY_ASSERTION_MAX_TTL_MS=120000
SERVER_REGISTRATION_SECRET=replace-with-server-registration-bootstrap-secret
# Legacy v1.0.1 fallback only:
# MATCH_SERVER_SECRET=replace-with-server-registration-bootstrap-secret
ACCEPTED_NETWORK_BUILDS=SP-1.0.1
SERVER_HEARTBEAT_TTL_MS=30000
NODE_CREDENTIAL_TTL_MS=21600000
NODE_CREDENTIAL_GRACE_MS=120000
REQUIRE_SERVER_ATTESTATION=true
ORCHESTRATOR_ATTESTATION_SECRET=replace-with-orchestrator-attestation-verifier-secret
SERVER_ATTESTATION_MAX_TTL_MS=120000
GAME_SERVER_PUBLIC_HOST=127.0.0.1
GAME_SERVER_PUBLIC_PORT=7777
